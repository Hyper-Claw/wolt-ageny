# Which chain the app talks to: "mainnet" | "testnet" | "local"
NEXT_PUBLIC_CHAIN=mainnet

# Deployed ArcLaunchpad address (from the contracts deploy)
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000

# Block the launchpad was deployed at, to bound event-log queries (optional)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# --- Arc mainnet (used when NEXT_PUBLIC_CHAIN=mainnet) ---
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_RPC=
NEXT_PUBLIC_ARC_EXPLORER=https://arc.exploreme.pro
