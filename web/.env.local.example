# Deployed ArcLaunchpad address (from `npm run deploy:arc` in ../contracts)
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000

# Block the launchpad was deployed at, to bound event-log queries (optional)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Overrides (optional) — defaults target Arc public testnet
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.testnet.arc.io
