# Deployer private key (funded with USDC gas on the target network)
PRIVATE_KEY=

# --- Arc mainnet ---
# Your RPC provider URL (e.g. from Infura/Blockdaemon/QuickNode) and the chain id.
ARC_MAINNET_RPC=
ARC_MAINNET_CHAIN_ID=

# Arc USDC ERC-20 pair token + decimals. On Arc this is the native USDC ERC-20.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
PAIRED_DECIMALS=6

# Platform fee recipient (defaults to the deployer)
FEE_RECIPIENT=

# --- Optional: use an existing Uniswap V3 (e.g. DyorSwap) instead of deploying our own ---
# If all three are set, the launchpad points at this V3; otherwise a fresh V3 is deployed.
POSITION_MANAGER=
SWAP_ROUTER=
V3_FACTORY=

# --- Arc testnet (optional) ---
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# --- Live smoke test (scripts/launch-and-trade.ts) ---
LAUNCHPAD=
BUY_USDC=1
