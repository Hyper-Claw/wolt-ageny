# Deployer private key (funded with native gas on the target network)
PRIVATE_KEY=

# Arc RPC (defaults to https://rpc.testnet.arc.io for the arcTestnet network)
ARC_TESTNET_RPC=

# Platform fee recipient (defaults to the deployer)
FEE_RECIPIENT=

# --- Uniswap V3 addresses on the target network ---
# If ALL four are set, deploy.ts uses this existing V3 deployment (live networks).
# If any is missing, deploy.ts deploys a fresh local V3 stack (dev only).
POSITION_MANAGER=
SWAP_ROUTER=
V3_FACTORY=
WNATIVE=
